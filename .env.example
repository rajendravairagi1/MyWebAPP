# Optional: enables real email delivery from the contact/consultation forms via Resend
# (https://resend.com). Without this set, submissions are still validated and logged
# server-side, but no email is sent.
RESEND_API_KEY=
RESEND_TO_EMAIL=Info@oneweblink.com
RESEND_FROM_EMAIL=Oneweblink Website <onboarding@resend.dev>

# Required to use /admin (blog post & case study editor). Pick any long random string.
# Without this set, the admin panel refuses all edits.
ADMIN_TOKEN=
